# MongoDB Atlas
# Paste the SRV connection string from MongoDB Atlas.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=booyah_arena

# Production admin credentials
BOOYAH_ADMIN_USER=CHANGE_THIS_ADMIN_USERNAME
BOOYAH_ADMIN_PASS=CHANGE_THIS_STRONG_PASSWORD

# UPI payment settings
BOOYAH_UPI_ID=9940879866@nyes
BOOYAH_UPI_NAME=BOOYAH ARENA

# Render supplies PORT automatically; keep this only for local testing.
PORT=8000

# Firebase Cloud Messaging
# Public web client config from Firebase Console > Project settings > Your apps > Web app.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
# Secret service-account JSON for the backend. Keep this in Render Environment Variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Usually the same Firebase project ID as FIREBASE_WEB_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Razorpay payment gateway (required for automatic deposits)
# Create these in Razorpay Dashboard and keep secrets only on the server.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public HTTPS URL of this BOOYAH Arena server (custom domain or Render URL).
# If omitted on Render, RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=
